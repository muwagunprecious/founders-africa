# Copy this file to .env and fill in your Supabase connection strings.

# Connection pooler URL — used by Prisma at runtime (PgBouncer / Supabase pooler)
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

NODE_ENV="development || production"